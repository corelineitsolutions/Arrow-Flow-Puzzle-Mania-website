# Arrow Flow Puzzle Mania - Environment Variables Configuration

# Game & Brand Details
NEXT_PUBLIC_APP_NAME="Arrow Flow Puzzle Mania"
NEXT_PUBLIC_SITE_URL="https://arrowflowgame.com"

# Store URLs (Set to valid URLs or leave placeholder for coming soon modal/message)
NEXT_PUBLIC_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=com.arrowflow.puzzlemania"
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/arrow-flow-puzzle-mania/id1234567890"

# Support Configuration
NEXT_PUBLIC_SUPPORT_EMAIL="corelineitsolutions@gmail.com"
NEXT_PUBLIC_SUPPORT_PHONE="8624851123"
NEXT_PUBLIC_SUPPORT_RESPONSE_TIME="Within 24-48 hours"

# Optional Email Dispatch Configuration (e.g., Resend, SMTP, or Webhook)
# If unconfigured, the POST /api/support endpoint automatically stores submissions securely in server memory/data store and generates a ticket ID
SUPPORT_EMAIL_PROVIDER="mock_storage" # Options: mock_storage, webhook, resend
SUPPORT_WEBHOOK_URL=""
RESEND_API_KEY=""
SUPPORT_NOTIFICATION_EMAIL="support-desk@arrowflowgame.com"

